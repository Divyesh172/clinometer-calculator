<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill="url(#g)"/>
  <!-- Right Triangle -->
  <polygon points="12,52 52,52 52,14" fill="none" stroke="#38bdf8" stroke-width="4" stroke-linejoin="round"/>
  <!-- Right angle mark -->
  <polyline points="44,52 44,44 52,44" fill="none" stroke="#38bdf8" stroke-width="2"/>
  <!-- Angle arc -->
  <path d="M 22,52 A 10,10 0 0,0 20,44" fill="none" stroke="#f59e0b" stroke-width="2.5"/>
  <!-- Plumb bob dot -->
  <circle cx="52" cy="14" r="3.5" fill="#f59e0b"/>
</svg>
